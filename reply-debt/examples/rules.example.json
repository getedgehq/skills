{
  "_comment": "Every list below REPLACES the built-in default wholesale, it does not extend it. Copy this file, then edit it against your own mail: run with --backend fixture and watch the drop counts before you trust the output. Unknown keys are rejected so a typo cannot silently do nothing.",

  "days": 10,
  "max_fetch": 60,
  "top": 10,

  "skip_sender": [
    "no-reply", "noreply", "donotreply", "[bot]",
    "notifications@", "newsletter", "mailer", "automated",
    "billing@", "receipts@", "marketing@", "promo"
  ],

  "skip_subject": [
    "invited you", "confirmation", "your flight", "itinerary",
    "newsletter", "% off", "sale", "webinar", "receipt", "invoice paid"
  ],

  "expects_reply": [
    "?", "let me know", "could you", "can you", "would you",
    "what do you think", "please", "when can", "available",
    "intro", "follow up", "following up", "any update",
    "proposal", "review", "feedback", "confirm", "deadline"
  ],

  "important_hints": [
    "investor", "legal", "contract", "client", "partner", "deadline"
  ],

  "wait_points_per_day": 2,
  "wait_days_cap": 14,
  "important_points": 6
}
