# reel-machine config. Copy to ~/.config/reel-machine/config.env (setup.sh does it) and edit.
# Non-secret values only. ELEVENLABS_API_KEY and BUFFER_TOKEN come from the environment.

# Where clips, transcripts, bundles and renders live
REEL_WORK=~/reel-machine

# Closer on the last frame: Instagram glyph + this handle
REEL_HANDLE=@yourhandle

# Scribe language code (en, de, ...). Leave empty to auto-detect.
REEL_LANGUAGE=en

# Fonts. Hook default: $REEL_WORK/fonts/FunnelDisplay.ttf (setup.sh fetches it).
# Captions default: Helvetica Neue Bold on macOS, else the hook font.
#REEL_HOOK_FONT=
#REEL_CAPTION_FONT=
#REEL_CAPTION_FONT_INDEX=

# Render look
REEL_SPEED=1.1
REEL_GRADE=eq=contrast=1.05:saturation=1.14:gamma=1.02,colorbalance=rm=-0.015:bm=0.015

# Optional: render on another machine with ffmpeg + Python + Pillow (ssh host alias)
#REEL_REMOTE=render-box

# Second model that reviews captions. Reads the prompt on stdin, prints its verdict.
# Examples: "codex exec -"   "claude -p"   "llm -m <model>"
#REEL_REVIEW_CMD=codex exec -

# Words your captions must never contain (comma list)
#REEL_BANNED_WORDS=

# Public hosting for rendered files (Buffer fetches media from a public URL with byte-range support)
#REEL_PUBLIC_BASE_URL=https://media.example.com/reels
#REEL_UPLOAD_CMD=rsync -q {file} user@static-host:/var/www/reels/

# Buffer channels: channel id or the channel's handle (run: scripts/schedule_reel.py channels)
#BUFFER_INSTAGRAM_CHANNEL=
#BUFFER_TIKTOK_CHANNEL=
#BUFFER_YOUTUBE_CHANNEL=
#BUFFER_IG_COLLAB=
YOUTUBE_CATEGORY_ID=28

# Captions: size and where the block ends (px above the bottom of 1080x1920; 495 = y~1425, above the app UI)
REEL_CAP_SIZE=55
REEL_CAP_BOTTOM=495

# Voice: raw voice + gentle EQ + loudness. Tune the EQ to your voice and mic. No isolation.
REEL_VOICE_EQ=highpass=f=90,equalizer=f=220:t=q:w=1.0:g=-3,equalizer=f=3300:t=q:w=1.0:g=2
REEL_LOUDNORM=I=-15:TP=-2:LRA=7

# Pace gate and jump cuts
REEL_MAX_GAP=0.35
REEL_MAX_DEAD=0.08
REEL_MIN_WPS=2.6
REEL_MAX_TEMPO=1.15

# Instagram Story reshare, minutes after the reel (schedule_reel.py --story)
REEL_STORY_DELAY_MIN=60

# Contact for the Wikimedia Commons User-Agent (commons.py); their API policy requires one
#REEL_HTTP_CONTACT=https://yoursite.example
