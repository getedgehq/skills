{
  "_comment": "Example only. Every list here is yours to replace. The script ships no default search terms, no default employers and no default geography.",
  "user_agent": "job-board-scout/1.0 (+https://github.com/getedgehq/skills)",
  "timeout_seconds": 25,
  "max_new_roles": 40,

  "feeds": [
    { "name": "Arbeitnow", "adapter": "arbeitnow", "url": "https://www.arbeitnow.com/api/job-board-api" },
    { "name": "Himalayas", "adapter": "himalayas", "url": "https://himalayas.app/jobs/api?limit=100" },
    { "name": "Jobicy", "adapter": "jobicy", "url": "https://jobicy.com/api/v2/remote-jobs?count=50" },
    { "name": "Remotive", "adapter": "remotive", "url": "https://remotive.com/api/remote-jobs?search=recruiter" }
  ],

  "ats_watchlist": [
    { "provider": "ashby", "board": "ramp", "company": "Ramp" },
    { "provider": "greenhouse", "board": "gitlab", "company": "GitLab" },
    { "provider": "lever", "board": "aircall", "company": "Aircall" }
  ],

  "filters": {
    "title_terms": [
      "recruiter", "recruiting", "recruitment", "talent acquisition",
      "talent partner", "talent sourc", "sourcer", "talent operations", "talent ops"
    ],
    "exclude_terms": [
      "ai trainer", "ai training", "ai evaluator", "ai rater", "ai annotator",
      "data annotat", "model trainer", "training data", "prompt evaluator",
      "hourly", "per hour", "per-hour", "/hour", "/hr", "paid by the hour",
      "volunteer", "unpaid", "commission only", "commission-only",
      "staffing coordinator", "scheduling coordinator", "recruiting coordinator",
      "recruitment coordinator", "recruiting administrator",
      "recruitment administrator", "credentialing specialist", "staffing administrator"
    ],
    "require_remote": true,
    "non_remote_terms": ["on-site", "onsite", "in office", "in-office", "hybrid"],
    "_geography_why": "allow_unstated is true because many remote listings state no country at all; set it to false only if you would rather miss those than read them. Tighten allow_terms to the countries you can actually be hired in.",
    "geography": {
      "enabled": true,
      "allow_unstated": true,
      "allow_patterns": [
        "\\b(?:europe|european union|emea|worldwide|world wide|global|anywhere|remote first|north america|americas)\\b"
      ],
      "allow_terms": [
        "united states", "canada", "united kingdom",
        "germany", "austria", "switzerland", "netherlands", "belgium",
        "luxembourg", "france", "spain", "portugal", "italy", "ireland",
        "denmark", "sweden", "finland", "norway", "iceland", "poland",
        "czech republic", "czechia", "slovakia", "slovenia", "croatia",
        "hungary", "romania", "bulgaria", "greece", "cyprus", "malta",
        "estonia", "latvia", "lithuania"
      ]
    }
  },

  "scoring": {
    "title_tiers": [
      { "phrase": "founding recruiter", "points": 18, "label": "founding recruiter scope" },
      { "phrase": "technical recruiter", "points": 16, "label": "technical recruiting scope" },
      { "phrase": "talent acquisition partner", "points": 15, "label": "TA partner scope" },
      { "phrase": "talent partner", "points": 13, "label": "talent partner scope" },
      { "phrase": "recruiter", "points": 12, "label": "recruiter ownership title" },
      { "phrase": "talent acquisition", "points": 11, "label": "talent-acquisition title" },
      { "phrase": "sourcer", "points": 9, "label": "sourcing ownership title" },
      { "phrase": "talent operations", "points": 8, "label": "talent-operations title" }
    ],
    "signal_terms": [
      { "phrase": "freelance", "points": 7, "label": "freelance wording" },
      { "phrase": "contract", "points": 6, "label": "contract wording" },
      { "phrase": "b2b", "points": 6, "label": "B2B wording" },
      { "phrase": "automation", "points": 4, "label": "automation scope" },
      { "phrase": "ai", "points": 3, "label": "AI context", "word_boundary": true },
      { "phrase": "sourcing", "points": 3, "label": "sourcing scope" },
      { "phrase": "recruiting operations", "points": 3, "label": "recruiting-operations scope" },
      { "phrase": "market mapping", "points": 3, "label": "market-mapping scope" }
    ],
    "direct_ats_bonus": 2
  }
}
